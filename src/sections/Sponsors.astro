---
import Typography from "@/components/Typography.astro"
import { SPONSORS } from "@/consts/sponsors"
import { sanityCdnClient, urlFor } from '../lib/sanity';

const query = `
	*[_type == "prioste" && active == true][0]
	{ name, mainUrl, mainPhoto }
`;

const prioste = await sanityCdnClient.fetch<{ name: string; mainUrl?: string; mainPhoto: any }>(query);
const priosteDesktopImageUrl = prioste.mainPhoto
	? urlFor(prioste.mainPhoto).width(512).height(512).crop("center").url()
	: null;
const priosteMobileImageUrl = prioste.mainPhoto
	? urlFor(prioste.mainPhoto).width(256).height(256).crop("center").url()
	: null;

---

<section class="my-40">
	<div class="mb-20 flex flex-col items-center justify-center gap-4 xs:flex-row">
		<Typography
			as="h3"
			variant="hermandadponsslab-title"
			color="primary400"
			class:list={"text-center"}
		>
			Priostes
		</Typography>
		<Typography as="h3" variant="h3" color="primary" class:list={"mt-4 text-center"}>
			{prioste.name}
		</Typography>
		<a
			class="transition hover:scale-110 focus:scale-110 motion-reduce:transition-none motion-reduce:hover:scale-100 motion-reduce:focus:scale-100"
			href={prioste.mainUrl || '#'}
			title="Ir a la página del Prioste de la fiesta"
			target="_blank"
			aria-label="Link con el logo/foto del Prioste"
		>
		<picture>
			<source
				srcset={priosteMobileImageUrl}
				media="(max-width: 640px)"
			/>
			<source
				srcset={priosteDesktopImageUrl}
				media="(min-width: 641px)"
			/>
			<img
				decoding="async"
				src={priosteDesktopImageUrl}
				loading="lazy"
				fetchpriority="low"
				alt={prioste.mainPhoto.alt || `Foto del prioste ${prioste.name}`}
				class="inline-block select-none text-white transition hover:text-accent focus:text-accent"
			/>
		</picture>
		</a>
	</div>

	<Typography as="h3" variant="h3" color="primary" class:list={"text-center"}>
		Patrocinadores
	</Typography>
	<Typography as="p" variant="body" color="primary" class:list={"mt-4 text-center"}>
		La fiesta en honor al patron Tayta Niño se puede llevar a cabo gracias a ...
	</Typography>
  <div class="mt-12 select-none flex justify-center items-center flex-shrink gap-2 md:gap-8">
    {
      SPONSORS.map(({id, name, logo, url}) => (
      	<a
					class="company-link group relative flex h-28 items-center justify-center md:h-32"
					title={`Visita la página del patrocinador ${name}`}
					href={url}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Link con el logo de ${name} que lleva a ${url}`}
				>
					<img
						decoding="async"
						src={`/img/sponsors/${logo.name ?? id}.webp`}
						width={logo.width}
						loading="lazy"
						height={logo.height}
						fetchpriority="low"
						alt={`Logo de ${name}`}
						class="company-logo px-5 text-white transition group-hover:scale-110 group-focus:scale-110 md:px-4"
					/>
				</a>
      ))
    }
  </div>
</section>